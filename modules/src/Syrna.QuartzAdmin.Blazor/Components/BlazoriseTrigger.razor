@using Blazorise.Components
@using Syrna.QuartzAdmin.Localization
@inject AbpBlazorMessageLocalizerHelper<QuartzAdminResource> LH
@inherits Volo.Abp.AspNetCore.Components.AbpComponentBase
<EnumSwitch T="TriggerType" ExcludedValues="ExcludedTriggerTypeChoices"
            Value="TriggerDetail.TriggerType"
            ValueIcons="TriggerTypeIcons" ValueChanged="TriggerTypeChanged" />
<Form Class="triggerForm">
    <Validations @ref="_validations" Mode="ValidationMode.Auto" Model="@TriggerDetail" StatusChanged="@OnSetValidationStatusChanged">
        <Card>
            <CardBody>
                <Grid>
                    <Column ColumnSize="ColumnSize.Is6">
                        <Validation AsyncValidator="(e,c)=> Validator.ValidateTriggerName(e, TriggerDetail, OriginalTriggerKey)">
                            <Field>
                                <FieldLabel RequiredIndicator="true">@L["TriggerDetail:Name"]</FieldLabel>
                                <FieldBody>
                                    <TextEdit @bind-Text="TriggerDetail.Name" Immediate="true">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextEdit>
                                </FieldBody>
                            </Field>
                        </Validation>
                    </Column>

                    <Column ColumnSize="ColumnSize.Is6">
                        <Field>
                            <FieldLabel RequiredIndicator="true">@L["TriggerDetail:Group"]</FieldLabel>
                            <FieldBody>
                                <Autocomplete TItem="SelectListItem"
                                              TValue="string"
                                              Data="@ExistingTriggerGroups"
                                              ReadData="@GetTriggerGroups"
                                              TextField="((item) => item.Text)"
                                              ValueField="((item) => item.Value)"
                                              @bind-SelectedValue="@TriggerDetail.Group"
                                              Placeholder="@L["SearchPlaceHolder"]"
                                              Filter="AutocompleteFilter.Contains"
                                              FreeTyping>
                                    <NotFoundContent>@string.Format(L["NotFoundContent"], context)</NotFoundContent>
                                    <ItemContent>
                                        <Paragraph Margin="Margin.Is2.FromBottom">@context.Text</Paragraph>
                                    </ItemContent>
                                </Autocomplete>
                            </FieldBody>
                        </Field>
                    </Column>

                    @if (TriggerDetail.TriggerType == TriggerType.Cron)
                    {
                        <Column ColumnSize="ColumnSize.Is6">
                            <Validation Validator="Validator.ValidateCronExpression">
                                <Field>
                                    <FieldLabel RequiredIndicator="true">@L["TriggerDetail:CronExpression"]</FieldLabel>
                                    <FieldBody>
                                        <Addons>
                                            <Addon AddonType="AddonType.Body">
                                                <TextEdit TextChanged="OnCronExpressionInputElapsed"
                                                          Text="@TriggerDetail.CronExpression">
                                                </TextEdit>
                                            </Addon>
                                            <Addon AddonType="AddonType.End">
                                                <Button Clicked="OnShowSampleCron">
                                                    <Tooltip Text="@L["TriggerDetail:CronExpressionTooltip"]">
                                                        <Icon Name="@IconName.QuestionCircle"></Icon>
                                                    </Tooltip>
                                                </Button>
                                            </Addon>
                                            <ValidationError />
                                        </Addons>
                                        <FieldHelp>@CronDescription</FieldHelp>
                                    </FieldBody>
                                </Field>
                            </Validation>
                        </Column>
                        <Column ColumnSize="ColumnSize.Is6">
                            <Field>
                                <FieldLabel RequiredIndicator="true">@L["TriggerDetail:InTimeZone"]</FieldLabel>
                                <FieldBody>
                                    <Autocomplete TItem="TimeZoneInfo"
                                                  TValue="string"
                                                  Data="@_timeZones"
                                                  TextField="((item) => item.DisplayName)"
                                                  ValueField="((item) => item.Id)"
                                                  @bind-SelectedValue="@TriggerDetail.InTimeZoneId"
                                                  Placeholder="@L["SearchPlaceHolder"]"
                                                  Filter="AutocompleteFilter.Contains">
                                        <NotFoundContent>@string.Format(L["NotFoundContent"], context)</NotFoundContent>
                                        <ItemContent>
                                            <Paragraph Margin="Margin.Is2.FromBottom">@context.Text</Paragraph>
                                        </ItemContent>
                                    </Autocomplete>
                                </FieldBody>
                            </Field>
                        </Column>
                    }
                    else
                    {
                        if (TriggerDetail.TriggerType == TriggerType.Daily)
                        {
                            @* Daily Trigger *@
                            <Column ColumnSize="ColumnSize.Is6">
                                <Validation Validator="ValidationRule.IsEmpty">
                                    <Field>
                                        <FieldLabel RequiredIndicator="true">@L["TriggerDetail:StartDailyTime"]</FieldLabel>
                                        <FieldBody>
                                            <TimePicker TimeAs24hr="true" Time="TriggerDetail.StartDailyTime" />
                                        </FieldBody>
                                    </Field>
                                </Validation>

                                <Validation Validator="((e) => Validator.ValidateTime(TriggerDetail.StartDailyTime, e))">
                                    <Field>
                                        <FieldLabel>@L["TriggerDetail:EndDailyTime"]</FieldLabel>
                                        <FieldBody>
                                            <TimePicker TValue="TimeSpan?" TimeAs24hr="true"
                                                        @ref="_endDailyTimePicker"
                                                        @bind-Time="TriggerDetail.EndDailyTime">
                                                <Feedback>
                                                    <ValidationError>@L["Error:EndTimeGtStartTime"]</ValidationError>
                                                </Feedback>
                                            </TimePicker>
                                        </FieldBody>
                                    </Field>
                                </Validation>

                                <Field>
                                    <FieldLabel RequiredIndicator="true">@L["TriggerDetail:InTimeZone"]</FieldLabel>
                                    <FieldBody>
                                        <Autocomplete TItem="TimeZoneInfo"
                                                      TValue="string"
                                                      Data="@_timeZones"
                                                      TextField="((item) => item.DisplayName)"
                                                      ValueField="((item) => item.Id)"
                                                      @bind-SelectedValue="@TriggerDetail.InTimeZoneId"
                                                      Placeholder="@L["SearchPlaceHolder"]"
                                                      Filter="AutocompleteFilter.Contains">
                                            <NotFoundContent>@string.Format(L["NotFoundContent"], context)</NotFoundContent>
                                            <ItemContent>
                                                <Paragraph Margin="Margin.Is2.FromBottom">@context.Text</Paragraph>
                                            </ItemContent>
                                        </Autocomplete>
                                    </FieldBody>
                                </Field>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is6">
                                <Validation Validator="DailyDayOfWeekValidation">
                                    <Field>
                                        <FieldLabel RequiredIndicator="true">@L["DayOfWeek"]</FieldLabel>
                                        <FieldBody>
                                            <Check TValue="bool" @bind-Checked="TriggerDetail.DailyDayOfWeek[(int)DayOfWeek.Monday]">@L["DayOfWeek:Monday"]</Check><br />
                                            <Check TValue="bool" @bind-Checked="TriggerDetail.DailyDayOfWeek[(int)DayOfWeek.Tuesday]">@L["DayOfWeek:Tuesday"]</Check><br />
                                            <Check TValue="bool" @bind-Checked="TriggerDetail.DailyDayOfWeek[(int)DayOfWeek.Wednesday]">@L["DayOfWeek:Wednesday"]</Check><br />
                                            <Check TValue="bool" @bind-Checked="TriggerDetail.DailyDayOfWeek[(int)DayOfWeek.Thursday]">@L["DayOfWeek:Thursday"]</Check><br />
                                            <Check TValue="bool" @bind-Checked="TriggerDetail.DailyDayOfWeek[(int)DayOfWeek.Friday]">@L["DayOfWeek:Friday"]</Check><br />
                                            <Check TValue="bool" @bind-Checked="TriggerDetail.DailyDayOfWeek[(int)DayOfWeek.Saturday]">@L["DayOfWeek:Saturday"]</Check><br />
                                            <Check TValue="bool" @bind-Checked="TriggerDetail.DailyDayOfWeek[(int)DayOfWeek.Sunday]">@L["DayOfWeek:Sunday"]</Check><br />
                                        </FieldBody>
                                        <FieldHelp>@L["SelectDaystoTrigger"]</FieldHelp>
                                    </Field>
                                </Validation>
                            </Column>
                        }
                        else if (TriggerDetail.TriggerType == TriggerType.Calendar)
                        {
                            <Column ColumnSize="ColumnSize.Is6">
                                <Field>
                                    <FieldLabel RequiredIndicator="true">@L["TriggerDetail:ModifiedByCalendar"]</FieldLabel>
                                    <FieldBody>
                                        <Autocomplete TItem="SelectListItem"
                                                      TValue="string"
                                                      Data="@_calendars"
                                                      ReadData="@GetCalendars"
                                                      TextField="((item) => item.Text)"
                                                      ValueField="((item) => item.Value)"
                                                      @bind-SelectedValue="@TriggerDetail.ModifiedByCalendar"
                                                      Placeholder="@L["SearchPlaceHolder"]"
                                                      Filter="AutocompleteFilter.Contains"
                                                      FreeTyping>
                                            <NotFoundContent>@string.Format(L["NotFoundContent"], context)</NotFoundContent>
                                            <ItemContent>
                                                <Paragraph Margin="Margin.Is2.FromBottom">@context.Text</Paragraph>
                                            </ItemContent>
                                        </Autocomplete>
                                    </FieldBody>
                                </Field>
                                <Tooltip Text="TODO: Coming Soon... Create Calendar">
                                    <Button Size="Size.Medium"><Icon Name="@IconName.Add"></Icon></Button>
                                </Tooltip>
                            </Column>
                            <Column ColumnSize="ColumnSize.Is6">
                                <Field>
                                    <FieldLabel RequiredIndicator="true">@L["TriggerDetail:InTimeZone"]</FieldLabel>
                                    <FieldBody>
                                        <Autocomplete TItem="TimeZoneInfo"
                                                      TValue="string"
                                                      Data="@_timeZones"
                                                      TextField="((item) => item.DisplayName)"
                                                      ValueField="((item) => item.Id)"
                                                      @bind-SelectedValue="@TriggerDetail.InTimeZoneId"
                                                      Placeholder="@L["SearchPlaceHolder"]"
                                                      Filter="AutocompleteFilter.Contains">
                                            <NotFoundContent>@string.Format(L["NotFoundContent"], context)</NotFoundContent>
                                            <ItemContent>
                                                <Paragraph Margin="Margin.Is2.FromBottom">@context.Text</Paragraph>
                                            </ItemContent>
                                        </Autocomplete>
                                    </FieldBody>
                                </Field>
                            </Column>
                        }

                        @* Simple Trigger/Daily Trigger *@
                        <Column ColumnSize="ColumnSize.Is6">
                            <Field>
                                <FieldLabel RequiredIndicator="@(TriggerDetail.TriggerType == TriggerType.Simple || TriggerDetail.TriggerType == TriggerType.Calendar)">@L["TriggerDetail:TriggerInterval"]</FieldLabel>
                                <FieldBody>
                                    <NumericEdit @bind-Value="TriggerDetail.TriggerInterval" Min="1" Step="1">
                                    </NumericEdit>
                                </FieldBody>
                            </Field>

                            <Validation Validator="@ValidationRule.IsSelected">
                                <Field>
                                    <FieldLabel RequiredIndicator="@(TriggerDetail.TriggerType == TriggerType.Simple || TriggerDetail.TriggerType == TriggerType.Calendar)">@L["TriggerDetail:TriggerIntervalUnit"]</FieldLabel>
                                    <FieldBody>
                                        <Select TValue="IntervalUnit?"
                                                @bind-SelectedValue="@TriggerDetail.TriggerIntervalUnit">
                                            <ChildContent>
                                                <Repeater Items="TriggerIntervalUnits">
                                                    <SelectItem TValue="IntervalUnit?" Value="@context">@L[$"IntervalUnit:{context.ToString()}"]</SelectItem>
                                                </Repeater>
                                            </ChildContent>
                                            <Feedback>
                                                <ValidationError>@L["Error:SelectOneValue"]</ValidationError>
                                            </Feedback>
                                        </Select>
                                    </FieldBody>
                                </Field>
                            </Validation>
                        </Column>
                        if (TriggerDetail.TriggerType == TriggerType.Simple)
                        {
                            <Column ColumnSize="ColumnSize.Is6">
                                <Field>
                                    <FieldLabel>@L["TriggerDetail:RepeatCount"]</FieldLabel>
                                    <FieldBody>
                                        <NumericEdit @bind-Value="TriggerDetail.RepeatCount"
                                                     Min="0"
                                                     Disabled="TriggerDetail.RepeatForever"
                                                     Step="1">
                                        </NumericEdit>
                                    </FieldBody>
                                </Field>
                                <Check TValue="bool" @bind-Checked="TriggerDetail.RepeatForever">@L["TriggerDetail:RepeatForever"]</Check>
                            </Column>
                        }
                    }

                    <Column ColumnSize="ColumnSize.Is6">
                        <Field>
                            <FieldLabel>@L["TriggerDetail:StartDate"]</FieldLabel>
                            <FieldBody>
                                <DatePicker Date="TriggerDetail.StartDate" StaticPicker="false" />
                            </FieldBody>
                        </Field>
                        <Field>
                            <FieldLabel>@L["TriggerDetail:StartTimeSpan"]</FieldLabel>
                            <FieldBody>
                                <TimePicker TimeAs24hr="true" Time="TriggerDetail.StartTimeSpan" StaticPicker="false" />
                            </FieldBody>
                        </Field>
                    </Column>

                    <Column ColumnSize="ColumnSize.Is6">
                        <Validation Validator="@((e) => Validator.ValidateFirstLastDateTime(TriggerDetail,e))">
                            <Field>
                                <FieldLabel>@L["TriggerDetail:EndDate"]</FieldLabel>
                                <FieldBody>
                                    <DatePicker TValue="DateTime?" StaticPicker="false"
                                                @ref="_endDatePicker"
                                                @bind-Date="TriggerDetail.EndDate">
                                        <Feedback>
                                            <ValidationError>@L["Error:EndDateGtStartDate"]</ValidationError>
                                        </Feedback>
                                    </DatePicker>
                                </FieldBody>
                            </Field>
                        </Validation>
                        <Validation Validator="@((e) => Validator.ValidateFirstLastDateTime(TriggerDetail,e))">
                            <Field>
                                <FieldLabel>@L["TriggerDetail:EndTimeSpan"]</FieldLabel>
                                <FieldBody>
                                    <TimePicker TValue="TimeSpan?" TimeAs24hr="true" StaticPicker="false"
                                                @bind-Time="TriggerDetail.EndTimeSpan">
                                        <Feedback>
                                            <ValidationError>@L["Error:EndTimeGtStartTime"]</ValidationError>
                                        </Feedback>
                                    </TimePicker>
                                </FieldBody>
                            </Field>
                        </Validation>
                    </Column>

                    @if (TriggerDetail.TriggerType != TriggerType.Calendar)
                    {
                        <Column ColumnSize="ColumnSize.Is6">
                            <Validation Validator="@ValidationRule.IsSelected">
                                <Field>
                                    <FieldLabel RequiredIndicator="true">@L["TriggerDetail:StartTimezone"]</FieldLabel>
                                    <FieldBody>
                                        <Select TValue="string" @bind-SelectedValue="TriggerDetail.StartTimezoneId">
                                            <ChildContent>
                                                <SelectItem TValue="string" Value="@(TimeZoneInfo.Utc.Id)">@TimeZoneInfo.Utc.DisplayName</SelectItem>
                                                @if (!TimeZoneInfo.Utc.Equals(TimeZoneInfo.Local))
                                                {
                                                    <SelectItem TValue="string" Value="@(TimeZoneInfo.Local.Id)">@TimeZoneInfo.Local.DisplayName</SelectItem>
                                                }
                                            </ChildContent>
                                            <Feedback>
                                                <ValidationError>@L["Error:SelectOneValue"]</ValidationError>
                                            </Feedback>
                                        </Select>
                                    </FieldBody>
                                </Field>
                            </Validation>
                        </Column>

                        <Column ColumnSize="ColumnSize.Is6">
                            <Field>
                                <FieldLabel>@L["TriggerDetail:ModifiedByCalendar"]</FieldLabel>
                                <FieldBody>
                                    <Autocomplete TItem="SelectListItem"
                                                  TValue="string"
                                                  Data="@_calendars"
                                                  ReadData="@GetCalendars"
                                                  TextField="((item) => item.Text)"
                                                  ValueField="((item) => item.Value)"
                                                  @bind-SelectedValue="@TriggerDetail.ModifiedByCalendar"
                                                  Placeholder="@L["SearchPlaceHolder"]"
                                                  Filter="AutocompleteFilter.Contains"
                                                  FreeTyping>
                                        <NotFoundContent>@string.Format(L["NotFoundContent"], context)</NotFoundContent>
                                        <ItemContent>
                                            <Paragraph Margin="Margin.Is2.FromBottom">@context.Text</Paragraph>
                                        </ItemContent>
                                    </Autocomplete>
                                </FieldBody>
                            </Field>

                            <Button Size="Size.Medium"
                                    title="Create Calendar">
                                <Icon Name="@IconName.Add"></Icon>
                            </Button>
                        </Column>
                    }

                    <Column ColumnSize="ColumnSize.Is6">
                        <Field>
                            <FieldLabel>@L["TriggerDetail:Priority"]</FieldLabel>
                            <FieldBody>
                                <NumericEdit TValue="int" @bind-Value="TriggerDetail.Priority"
                                             Placeholder="@L["TriggerDetail:PriorityPlaceholder"]"
                                             Step="1" />
                            </FieldBody>
                        </Field>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is6">
                        <Validation Validator="@ValidationRule.IsSelected">
                            <Field>
                                <FieldLabel>@L["TriggerDetail:MisfireAction"]</FieldLabel>
                                <FieldBody>
                                    <Select TValue="MisfireAction"
                                            @bind-SelectedValue="@TriggerDetail.MisfireAction">
                                        <ChildContent>
                                            <Repeater Items="MisfireActions">
                                                <SelectItem TValue="MisfireAction" Value="@context">@L[$"MisfireAction:{context.ToString()}"]</SelectItem>
                                            </Repeater>
                                        </ChildContent>
                                        <Feedback>
                                            <ValidationError>@L["Error:SelectOneValue"]</ValidationError>
                                        </Feedback>
                                    </Select>
                                </FieldBody>
                                <FieldHelp>@L[$"MisfireAction:{TriggerDetail.MisfireAction.ToString()}:Description"]</FieldHelp>
                            </Field>
                        </Validation>
                    </Column>
                    <Column ColumnSize="ColumnSize.Is6">
                        <Field>
                            <FieldLabel>@L["TriggerDetail:Description"]</FieldLabel>
                            <FieldBody>
                                <MemoEdit @bind-Text="TriggerDetail.Description"
                                          Rows="2"
                                          Immediate="true" />
                            </FieldBody>
                        </Field>
                    </Column>
                </Grid>
            </CardBody>
            <CardFooter>
                <Bar Breakpoint="Breakpoint.Desktop" Background="Background.Light" Shadow="Shadow.Remove" ThemeContrast="ThemeContrast.Light">
                    <BarBrand>
                        <Heading Size="HeadingSize.Is6">@L["JobDataMap"]</Heading>
                    </BarBrand>
                    <BarStart>
                    </BarStart>
                    <BarEnd>
                        <Button Color="Color.Primary"
                                Clicked="@OnAddDataMap">
                            <Icon Name="@IconName.Add" />@L["JobDataMap:Add"]
                        </Button>
                    </BarEnd>
                </Bar>
                <Card>
                    <CardBody>
                        <Table Hoverable="true" Narrow="true"
                               Striped="true" Borderless="true"
                               FixedHeader="true" Style="max-height: 180px; overflow: auto;">
                            <TableHeader>
                                <TableRow>
                                    <TableHeaderCell>@L["JobDataMap:Key"]</TableHeaderCell>
                                    <TableHeaderCell>@L["JobDataMap:Value"]</TableHeaderCell>
                                    <TableHeaderCell Style="width: 200px;">@L["JobDataMap:Type"]</TableHeaderCell>
                                    <TableHeaderCell Style="width: 120px;"></TableHeaderCell>
                                </TableRow>
                            </TableHeader>
                            <TableBody>
                                @foreach (var row in TriggerDetail.TriggerDataMap)
                                {
                                    <TableRow>
                                        <TableRowCell>@row.Key</TableRowCell>
                                        <TableRowCell>@row.Value.ToString()</TableRowCell>
                                        <TableRowCell>@GetDataMapTypeDescription(row)</TableRowCell>
                                        <TableRowCell>
                                            <Button Size="Size.Small" Clicked="() => OnEditDataMap(row)" title="Edit">
                                                <Icon Name="@IconName.Edit" />
                                            </Button>
                                            <Button Size="Size.Small" Clicked="() => OnCloneDataMap(row)" title="Copy">
                                                <Icon Name="@IconName.Copy" />
                                            </Button>
                                            <Button Size="Size.Small" Clicked="() => OnDeleteDataMap(row)" title="Delete">
                                                <Icon Name="@IconName.Delete" />
                                            </Button>
                                        </TableRowCell>
                                    </TableRow>
                                }
                            </TableBody>
                        </Table>
                    </CardBody>
                </Card>
            </CardFooter>
        </Card>
    </Validations>
</Form>
<JobDataMapDialog @ref="JobDataMapDialogRef" />
<CronSamplesDialog @ref="CronSamplesDialogRef" />