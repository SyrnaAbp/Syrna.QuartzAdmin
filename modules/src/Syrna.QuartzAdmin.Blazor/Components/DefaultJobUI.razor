@using Syrna.QuartzAdmin.Localization
@inject AbpBlazorMessageLocalizerHelper<QuartzAdminResource> LH
@inherits Volo.Abp.AspNetCore.Components.AbpComponentBase
<Bar Breakpoint="Breakpoint.Desktop" Background="Background.Light" Shadow="Shadow.Remove" ThemeContrast="ThemeContrast.Light">
    <BarBrand>
        <Heading Size="HeadingSize.Is6">@L["JobDataMap"]</Heading>
    </BarBrand>
    <BarStart>
    </BarStart>
    <BarEnd>
        <Button Color="Color.Primary"
                Clicked="@OnAddDataMap"
                Disabled="@IsReadOnly">
            <Icon Name="@IconName.Add" />@L["JobDataMap:Add"]
        </Button>
    </BarEnd>
</Bar>
<Card>
    <CardBody>
        <Table Hoverable="true"
               Striped="true" Borderless="true"
               FixedHeader="true" Style="max-height: 280px; overflow: auto;">
            <colgroup>
                <col />
                <col />
                <col style="width: 200px;" />
                <col style="width: 120px;" />
            </colgroup>
            <thead>
                <tr>
                    <th>@L["JobDataMap:Key"]</th>
                    <th>@L["JobDataMap:Value"]</th>
                    <th>@L["JobDataMap:Type"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in JobDetail.JobDataMap)
                {
                    <tr>
                        <td>@row.Key</td>
                        <td>@row.Value.ToString()</td>
                        <td>@GetDataMapTypeDescription(row)</td>
                        <td>
                            <Button Size="Size.Small"
                                    Clicked="() => OnEditDataMap(row)"
                                    Disabled="@IsReadOnly"
                                    title="Edit">
                                <Icon Name="@IconName.Edit"></Icon>
                            </Button>
                            <Button Size="Size.Small"
                                    Clicked="() => OnCloneDataMap(row)"
                                    Disabled="@IsReadOnly"
                                    title="Copy">
                                <Icon Name="@IconName.Paste"></Icon>
                            </Button>
                            <Button Size="Size.Small"
                                    Clicked="() => OnDeleteDataMap(row)"
                                    Disabled="@IsReadOnly" title="Delete">
                                <Icon Name="@IconName.Delete"></Icon>
                            </Button>
                        </td>
                    </tr>
                }
            </tbody>
        </Table>
    </CardBody>
</Card>
<JobDataMapDialog @ref="JobDataMapDialogRef" />